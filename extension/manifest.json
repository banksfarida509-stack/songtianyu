{
  "manifest_version": 3,
  "name": "AI 招聘副驾",
  "version": "0.1.3",
  "description": "在招聘平台页面内读取简历做 AI 初筛、给出约聊回复建议。只读本账号能看到的页面数据，发送和打招呼都由专员确认。",
  "permissions": ["storage"],
  "host_permissions": ["https://rd6.zhaopin.com/*", "http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://rd6.zhaopin.com/*"], "js": ["inject.js"], "world": "MAIN", "run_at": "document_idle" },
    { "matches": ["https://rd6.zhaopin.com/*"], "js": ["config.js", "content.js"], "css": ["content.css"], "run_at": "document_idle" }
  ],
  "action": { "default_title": "AI 招聘副驾", "default_popup": "options.html" },
  "options_page": "options.html"
}
